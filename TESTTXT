def process_students_data(data_list):
    # 성적 계산과 출력, 예외 처리가 뒤섞인 레거시 함수
    results = []
    for item in data_list:
        name = item['name']
        scores = item['scores']

        # 하드코딩된 계산 로직
        total = sum(scores)
        avg = total / len(scores)

        if avg >= 90:
            grade = 'A'
        elif avg >= 80:
            grade = 'B'
        else:
            grade = 'C'

        print(f"학생 이름: {name}, 총점: {total}, 평균: {avg:.2f}, 등급: {grade}")
        results.append({'name': name, 'avg': avg, 'grade': grade})

    return results
